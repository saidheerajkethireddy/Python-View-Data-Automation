#  EXCEL WRITER
# ══════════════════════════════════════════════════════════════════════════════

def write_block(wd, ws_sum, cell_ref,
                cur_result, prev_result, providers,
                channel, region_key, region_label, comp_type,
                cur_anchor, prev_anchor):
    ch_disp = CHANNEL_DISPLAY.get(channel, channel)

    col_letter, row_num = coordinate_from_string(cell_ref)
    c = column_index_from_string(col_letter)
    r = int(row_num)

    def dn(p): return PROVIDER_DISPLAY_NAMES.get(p, p)

    ORANGE_HDR = PatternFill("solid", start_color="FCE4D6", end_color="FCE4D6")
    ORANGE_LBL = PatternFill("solid", start_color="FCE4D6", end_color="FCE4D6")
    WHITE      = PatternFill("solid", start_color="FFFFFF", end_color="FFFFFF")
    F_HDR      = Font(name="Calibri", bold=False, size=11)
    F_DATA     = Font(name="Calibri", size=11)
    F_SUMMARY  = Font(name="Calibri", bold=True, size=10)
    CNTR       = Alignment(horizontal="center", vertical="center")
    LEFT       = Alignment(horizontal="left",   vertical="center")
    thin       = Side(style="thin", color="D9D9D9")
    BDR        = Border(left=thin, right=thin, top=thin, bottom=thin)

    def sty(cell, font=None, fill=None, align=None, num_fmt=None):
        if font:    cell.font          = font
        if fill:    cell.fill          = fill
        if align:   cell.alignment     = align
        if num_fmt: cell.number_format = num_fmt
        cell.border = BDR

    # Summary one row above
    summary = (f"R{ROLLING} | {region_label} | {ch_disp} | "
               f"Cur: {cur_anchor} | Prev ({comp_type}): {prev_anchor}")
    sc = wd.cell(row=r - 1, column=c, value=summary)
    sc.font      = F_SUMMARY
    sc.alignment = LEFT

    # Header row
    hdr_cell = wd.cell(row=r, column=c, value="Series")
    sty(hdr_cell, font=F_HDR, fill=ORANGE_HDR, align=LEFT)
    hdr_cell.alignment = Alignment(horizontal="left", vertical="top", wrap_text=True)

    for i, p in enumerate(providers):
        ci   = c + 1 + i
        cell = wd.cell(row=r, column=ci, value=dn(p))
        sty(cell, font=F_HDR, fill=ORANGE_HDR, align=CNTR)
        wd.column_dimensions[get_column_letter(ci)].width = 12
    wd.column_dimensions[get_column_letter(c)].width = 12
    wd.row_dimensions[r].height = 16

    # Data rows
    for row_i, (anchor, result) in enumerate([(cur_anchor, cur_result),
                                               (prev_anchor, prev_result)]):
        r2  = r + 1 + row_i
        lbl = wd.cell(row=r2, column=c, value=anchor)
        sty(lbl, font=F_HDR, fill=ORANGE_LBL, align=LEFT)

        for i, p in enumerate(providers):
            ci  = c + 1 + i
            val = result.get(p)
            cell = wd.cell(row=r2, column=ci,
                           value=round(val, 4) if val is not None else "—")
            sty(cell, font=F_DATA, fill=WHITE, align=CNTR,
                num_fmt="0.0000" if val is not None else None)
        wd.row_dimensions[r2].height = 16

    # Run log
    next_row = ws_sum.max_row + 1
    log_vals = [
        datetime.now().strftime("%Y-%m-%d %H:%M"),
        ch_disp, f"R{ROLLING}", region_label,
        cur_anchor, prev_anchor, comp_type, cell_ref,
        ", ".join(dn(p) for p in providers),
    ]
    log_widths = [18, 28, 6, 18, 10, 10, 6, 8, 80]
    for ci2, (val, w) in enumerate(zip(log_vals, log_widths), start=1):
        sc2 = ws_sum.cell(row=next_row, column=ci2, value=val)
        sc2.font      = Font(name="Calibri", size=10)
        sc2.alignment = LEFT
        ws_sum.column_dimensions[get_column_letter(ci2)].width = w
    ws_sum.row_dimensions[next_row].height = 15


