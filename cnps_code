def sep(char="─", w=100): print(char * w)
def sep2(w=100):           print("═" * w)


def print_block(cur_result, prev_result, providers,
                channel, region_label, comp_type, cur_anchor, prev_anchor):
    ch_disp  = CHANNEL_DISPLAY.get(channel, channel)
    summary  = (f"R{ROLLING} | {region_label} | {ch_disp} | "
                f"Cur: {cur_anchor} | Prev ({comp_type}): {prev_anchor}")
    sep2()
    print(f"  {summary}")
    sep2()

    def dn(p): return PROVIDER_DISPLAY_NAMES.get(p, p)

    LABEL_W = 10
    COL_W   = 12

    hdr = f"  {'Series':<{LABEL_W}}"
    for p in providers:
        hdr += f"{dn(p):>{COL_W}}"
    sep()
    print(hdr)
    sep()

    row_cur = f"  {cur_anchor:<{LABEL_W}}"
    for p in providers:
        v = cur_result.get(p)
        row_cur += f"{(f'{v:.4f}' if v is not None else '—'):>{COL_W}}"
    print(row_cur)

    row_prev = f"  {prev_anchor:<{LABEL_W}}"
    for p in providers:
        v = prev_result.get(p)
        row_prev += f"{(f'{v:.4f}' if v is not None else '—'):>{COL_W}}"
    print(row_prev)

    sep()
    print()


