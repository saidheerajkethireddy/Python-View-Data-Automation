# ══════════════════════════════════════════════════════════════════════════════
#  PERIOD HELPERS
# ══════════════════════════════════════════════════════════════════════════════

def get_rolling_periods(anchor, n_quarters, avail_periods):
    ordered = [p for p in PERIOD_ORDER if p in avail_periods]
    if anchor not in ordered:
        return [anchor]
    idx   = ordered.index(anchor)
    start = max(0, idx - n_quarters + 1)
    return ordered[start: idx + 1]


def derive_anchors(avail_periods):
    cur = avail_periods[-1]
    idx = avail_periods.index(cur)
    yoy = avail_periods[idx - 4] if idx >= 4 else None
    qoq = avail_periods[idx - 1] if idx >= 1 else None
    return cur, yoy, qoq


# ══════════════════════════════════════════════════════════════════════════════
#  cNPS FORMULA
# ══════════════════════════════════════════════════════════════════════════════

def compute_cnps(data, channel_filter):
    if channel_filter:
        data = data[data["nps_initial_channel_group"].isin(channel_filter)]
    out = {}
    for provider, grp in data.groupby("provider_name"):
        den = grp["nps_nps_weight"].sum()
        if den == 0:
            continue
        out[provider] = round(
            (grp["nps_nps_weight"] * grp["nps_nps_category_value"]).sum() / den * 100, 4
        )
    return out


def compute_rolling_cnps(df_region, anchor, n_quarters, avail_periods, channel_filter):
    periods = get_rolling_periods(anchor, n_quarters, avail_periods)
    return compute_cnps(
        df_region[df_region["nps_period"].isin(periods)].copy(),
        channel_filter
    )


