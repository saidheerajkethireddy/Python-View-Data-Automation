def main():
    sep2()
    print("  cNPS CALCULATOR  —  Canada P&C Insurance  |  Channel NPS")
    sep2()
    print("\n📂  Loading data...")

    df = pd.read_csv(CSV_PATH, usecols=COLS, low_memory=False)
    df["nps_nps_category_value"] = pd.to_numeric(df["nps_nps_category_value"], errors="coerce")
    df["nps_nps_weight"]         = pd.to_numeric(df["nps_nps_weight"],         errors="coerce")
    df = df.dropna(subset=["nps_nps_category_value", "nps_nps_weight"])

    avail_periods = [p for p in PERIOD_ORDER if p in df["nps_period"].unique()]
    cur, yoy, qoq = derive_anchors(avail_periods)

    print(f"✅  Ready.")
    print(f"    Rolling        : R{ROLLING}")
    print(f"    Current        : {cur}  →  rolling periods: {get_rolling_periods(cur, ROLLING, avail_periods)}")
    print(f"    YoY (4Q back)  : {yoy or '(not available)'}  →  rolling periods: "
          f"{get_rolling_periods(yoy, ROLLING, avail_periods) if yoy else 'n/a'}")
    print(f"    QoQ (1Q back)  : {qoq or '(not available)'}  →  rolling periods: "
          f"{get_rolling_periods(qoq, ROLLING, avail_periods) if qoq else 'n/a'}")
    print()

    try:
        wb = load_workbook(OUTPUT_PATH)
    except FileNotFoundError:
        wb = Workbook()
        if "Sheet" in wb.sheetnames:
            del wb["Sheet"]

    if DATA_SHEET not in wb.sheetnames:
        wb.create_sheet(DATA_SHEET)
    wd = wb[DATA_SHEET]

    if SUMMARY_SHEET not in wb.sheetnames:
        ws_sum = wb.create_sheet(SUMMARY_SHEET)
        hdr_row = ["Timestamp", "Channel", "Rolling", "Region",
                   "Current", "Previous", "Type", "Cell", "Providers"]
        for ci, h in enumerate(hdr_row, start=1):
            c = ws_sum.cell(row=1, column=ci, value=h)
            c.font      = Font(name="Calibri", bold=True, size=10, color="FFFFFF")
            c.fill      = PatternFill("solid", start_color="C00000", end_color="C00000")
            c.alignment = Alignment(horizontal="center", vertical="center")
    else:
        ws_sum = wb[SUMMARY_SHEET]

    comp_map = [("YoY", yoy), ("QoQ", qoq)]
    total    = 0

    for channel in ["Digital", "Call Center", "Broker/Agent"]:
        ch_filter = CHANNEL_GROUPS[channel]

        for region_key in [1, 2, 3]:
            region_label, regions = REGION_OPTIONS[region_key]
            df_region = df[df["nps_region"].isin(regions)].copy()
            providers = PROVIDER_ORDER[(region_key, channel)]

            cur_result = compute_rolling_cnps(df_region, cur, ROLLING, avail_periods, ch_filter)

            for comp_type, prev_anchor in comp_map:
                cell_ref = CELL_MAP.get((channel, region_key, comp_type))

                if cell_ref is None:
                    print(f"  ⚠️  No cell defined: {channel} | {region_label} | {comp_type} — skipped")
                    continue
                if prev_anchor is None:
                    print(f"  ⚠️  {comp_type} anchor not available — skipped")
                    continue

                prev_result = compute_rolling_cnps(df_region, prev_anchor, ROLLING,
                                                   avail_periods, ch_filter)

                print_block(cur_result, prev_result, providers,
                            channel, region_label, comp_type, cur, prev_anchor)

                write_block(wd, ws_sum, cell_ref,
                            cur_result, prev_result, providers,
                            channel, region_key, region_label, comp_type,
                            cur, prev_anchor)
                total += 1

    wb.save(OUTPUT_PATH)
    print(f"\n✅  {total} blocks written → {OUTPUT_PATH}")
    print(f"     Sheet '{DATA_SHEET}'    — see CELL_MAP for locations")
    print(f"     Sheet '{SUMMARY_SHEET}' — {total} rows logged\n")


if __name__ == "__main__":
    main()