#  MAIN
# ══════════════════════════════════════════════════════════════════════════════

def main():
    sep2()
    print("  pNPS CALCULATOR  —  Canada P&C Insurance")
    sep2()
    print("\n📂  Loading data...")

    df = pd.read_csv(CSV_PATH, usecols=COLS, low_memory=False)
    df["nps_nps_category_value"] = pd.to_numeric(df["nps_nps_category_value"], errors="coerce")
    df["nps_nps_weight"]         = pd.to_numeric(df["nps_nps_weight"],         errors="coerce")
    df = df.dropna(subset=["nps_nps_category_value", "nps_nps_weight"])

    avail_periods = [p for p in PERIOD_ORDER if p in df["nps_period"].unique()]
    anchors       = derive_anchors(avail_periods)

    print(f"✅  Ready.")
    print(f"    Periods  : {anchors[0]} → {anchors[-1]}  ({len(anchors)} quarters)")
    print(f"    Blocks   : 12  (R1 + R4 × Auto + Home × 3 regions)\n")

    # Open / create workbook
    try:
        wb = load_workbook(OUTPUT_PATH)
    except FileNotFoundError:
        wb = Workbook()
        if "Sheet" in wb.sheetnames:
            del wb["Sheet"]

    if DATA_SHEET not in wb.sheetnames:
        wb.create_sheet(DATA_SHEET)
    wd = wb[DATA_SHEET]

    if SUMMARY_SHEET not in wb.sheetnames:
        ws_sum = wb.create_sheet(SUMMARY_SHEET)
        hdr_row = ["Timestamp", "Product", "Rolling", "Region",
                   "Latest", "All Anchors", "Cell", "Providers"]
        for ci, h in enumerate(hdr_row, start=1):
            hc = ws_sum.cell(row=1, column=ci, value=h)
            hc.font      = Font(name="Arial", bold=True, size=10)
            hc.fill      = PatternFill("solid", start_color="D9D9D9", end_color="D9D9D9")
            hc.alignment = Alignment(horizontal="center", vertical="center")
    else:
        ws_sum = wb[SUMMARY_SHEET]

    total = 0
    for r_size in [1, 4]:
        for prod_csv, prod_label in [("Car", "Auto"), ("Home", "Home")]:
            for region_key in [1, 2, 3]:
                region_label, regions = REGION_OPTIONS[region_key]
                providers = PROVIDER_ORDER[(prod_csv, region_key)]
                cell_ref  = CELL_MAP[(r_size, prod_csv, region_key)]

                df2 = df[
                    (df["nps_product"] == prod_csv) &
                    (df["nps_region"].isin(regions))
                ].copy()

                avail = [p for p in PERIOD_ORDER if p in df2["nps_period"].unique()]
                block_anchors = derive_anchors(avail)

                # Compute pNPS for each anchor with rolling window
                period_results = {}
                for anchor in block_anchors:
                    period_results[anchor] = compute_rolling_pnps(df2, anchor, r_size, avail)

                print_block(period_results, block_anchors, providers,
                            prod_label, region_label, r_size, cell_ref)

                write_block(wd, ws_sum, cell_ref, period_results, block_anchors,
                            providers, prod_label, region_label, r_size)
                total += 1

    wb.save(OUTPUT_PATH)
    print(f"\n✅  {total} blocks written → {OUTPUT_PATH}")
    print(f"     Sheet '{DATA_SHEET}'    — see CELL_MAP for locations")
    print(f"     Sheet '{SUMMARY_SHEET}' — {total} rows logged\n")


if __name__ == "__main__":
    main()